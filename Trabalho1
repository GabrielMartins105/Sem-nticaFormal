-----Unless e Swap---
trocaSeDiferentes :: C  
trocaSeDiferentes =
    Unless
        (Igual (Var "x") (Var "y"))
        (Swap (Var "x") (Var "y"))
        Skip

----SevenTimes------
multSete :: C
multSete =
    Seq (Atrib (Var "y") (Num 0))
        (SevenTimes
            (Atrib (Var "y") (Soma (Var "y") (Var "x"))))

-----DoWhile e Assert-------
dobraMenor :: C
dobraMenor =
    Assert (Not (Leq (Var "y") (Num 0)))
        (Assert (Not (Leq (Var "x") (Var "y")))
            (DoWhile
                (Atrib (Var "y") (Mult (Var "y") (Num 2)))
                (Not (Leq (Var "x") (Var "y")))))

------DuplaAtrib e AtribCond-------
maiorMenor :: C
maiorMenor =
    Seq
        (DuplaATrib
            (Var "maior") (Var "menor")
            (Var "x") (Var "y"))
        (Seq
            (AtribCond
                (Leq (Var "x") (Var "y"))
                (Var "maior")
                (Var "y")
                (Var "x"))
            (AtribCond
                (Leq (Var "x") (Var "y"))
                (Var "menor")
                (Var "x")
                (Var "y")))

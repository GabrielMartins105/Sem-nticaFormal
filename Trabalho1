
-- Definição das árvore sintática para representação dos programas:

data E = Num Int
      |Var String
      |Soma E E
      |Sub E E
      |Mult E E
      |Div E E
   deriving(Eq,Show)

data B = TRUE
      | FALSE
      | Not B
      | And B B
      | Or  B B
      | Leq E E    -- menor ou igual
      | Igual E E  -- verifica se duas expressões aritméticas são iguais
   deriving(Eq,Show)

data C = While B C
    | If B C C
    | Seq C C
    | Atrib E E
    | Skip
    | SevenTimes C   ---- Executa o comando C 7 vezes
    | DoWhile C B      ---- Do C While B: executa C enquanto B avalie para verdadeiro
    | DuplaATrib E E E E -- recebe 2 variáveis e 2 expressões (DuplaATrib (Var v1) (Var v2) e1 e2) e faz v1:=e1 e v2:=e2
    | AtribCond B E E E --- AtribCond b (Var v1) e1 e2: se b for verdade, então faz v1:e1, se B for falso faz v1:=e2
    | Swap E E -- swap(x,y): troca o conteúdo das variáveis x e y 
    | Unless B C C   ---- Unless B C1 C2: se B avalia para falso, então executa C1, caso contrário, executa C2
    | Assert B C     --- caso B avalie para True então executa C. Caso contrário, não faz nada
   deriving(Eq,Show)                


type Memoria = [(String,Int)]

----------------------------
-------Expressões Aritméticas--------------
-------------------------------


--- Dado um nome, procura a variavel correspondente na memoria e retorna o seu valor.
procuraVar :: Memoria -> String -> Int
procuraVar [] s = error ("Variavel " ++ s ++ " nao definida no estado")
procuraVar ((s,i):xs) v
  | s == v     = i
  | otherwise  = procuraVar xs v 

----- Atribuição 
mudaVar :: Memoria -> String -> Int -> Memoria
mudaVar [] v n = error ("Variavel " ++ v ++ " nao definida no estado")
mudaVar ((s,i):xs) v n
  | s == v     = ((s,n):xs)
  | otherwise  = (s,i): mudaVar xs v n


ebigStep :: (E,Memoria) -> Int
ebigStep (Var x,s) = procuraVar s x
ebigStep (Num n,s) = n
ebigStep (Soma e1 e2,s)  = ebigStep (e1,s) + ebigStep (e2,s)
ebigStep (Sub e1 e2,s)  = ebigStep (e1,s) - ebigStep (e2,s)
ebigStep (Mult e1 e2,s)  = ebigStep (e1,s) * ebigStep (e2,s)
ebigStep (Div e1 e2,s) = ebigStep (e1,s) `div` ebigStep (e2,s)


-------------------------------------
-----------Expressões Booleanas----------------
-------------------------------------
bbigStep :: (B,Memoria) -> Bool
bbigStep (TRUE,s)  = True
bbigStep (FALSE,s) = False
bbigStep (Not b,s) 
    | bbigStep (b,s) == True     = False
    | otherwise                  = True 
bbigStep (And b1 b2,s )
    | bbigStep (b1,s) == False = False
    | otherwise = bbigStep(b2,s)
bbigStep (Or b1 b2,s )
    | bbigStep(b1,s) == True = True
    | otherwise = bbigStep(b2,s)
bbigStep (Leq e1 e2,s) = ebigStep (e1,s) <= ebigStep (e2,s)
bbigStep (Igual e1 e2,s) = ebigStep (e1,s) == ebigStep (e2,s) 

---------------------------------------
-----------------LOOPS-------------------
-----------------------------

cbigStep :: (C,Memoria) -> (C,Memoria)

cbigStep (Skip,s) = (Skip,s)

cbigStep (If b c1 c2,s)
    | bbigStep(b,s) == True = cbigStep(c1,s)
    | otherwise = cbigStep(c2,s)

cbigStep (Seq c1 c2,s) =
    let (_,s1) = cbigStep(c1,s)
    in cbigStep(c2,s1)

cbigStep (Atrib (Var x) e,s) =
    let valor = ebigStep(e,s)
    in (Skip,mudaVar s x valor)

cbigStep (While b c,s)
    | bbigStep(b,s) == True = cbigStep(Seq c (While b c),s)
    | otherwise = cbigStep(Skip,s)

cbigStep (SevenTimes c,s) =
    cbigStep(Seq c (Seq c (Seq c (Seq c (Seq c (Seq c c))))),s)

cbigStep (DoWhile c b,s) =
    cbigStep(Seq c (While b c),s)

cbigStep (DuplaATrib (Var v1) (Var v2) e1 e2,s) =
    let valor1 = ebigStep(e1,s)
        valor2 = ebigStep(e2,s)
        s1 = mudaVar s v1 valor1
        s2 = mudaVar s1 v2 valor2
    in (Skip,s2)

cbigStep (AtribCond b (Var v) e1 e2,s)
    | bbigStep(b,s) == True = cbigStep(Atrib (Var v) e1,s)
    | otherwise = cbigStep(Atrib (Var v) e2,s)

cbigStep (Swap (Var x) (Var y),s) =
    cbigStep(DuplaATrib (Var x) (Var y) (Var y) (Var x),s)

cbigStep (Unless b c1 c2,s)
    | bbigStep(b,s) == True = cbigStep(c2,s)
    | otherwise = cbigStep(c1,s)

cbigStep (Assert b c,s)
    | bbigStep(b,s) == True = cbigStep(c,s)
    | otherwise = cbigStep(Skip,s)

cbigStep (Atrib _ _,s) =
    error "Atrib requer uma variavel"

cbigStep (DuplaATrib _ _ _ _,s) =
    error "DuplaATrib requer duas variaveis"

cbigStep (AtribCond _ _ _ _,s) =
    error "AtribCond requer uma variavel"

cbigStep (Swap _ _,s) =
    error "Swap requer duas variaveis"

